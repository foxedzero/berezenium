  - {fileID: 4875296283915153683}
  EnergosystemDescribtion:
  - "\u0410\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440 \r\n\r\n\u0423\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u043E
    \u0434\u043B\u044F \u0445\u0440\u0430\u043D\u0435\u043D\u0438\u044F \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u044D\u043D\u0435\u0440\u0433\u0438\u0438
    \u0437\u0430 \u0441\u0447\u0435\u0442 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u044F\u0449\u0438\u0445
    \u0432 \u043D\u0435\u043C \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0440\u0435\u0430\u043A\u0446\u0438\u0439. \u0414\u043E\u0440\u0430\u0431\u043E\u0442\u043A\u0438
    \u043D\u0430\u0448\u0438\u0445 \u0443\u0447\u0435\u043D\u044B\u0445 \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442
    \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u0430\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u044B \u0432
    \u0441\u0443\u0440\u043E\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445
    \u0411\u0435\u0440\u0435\u0437\u0438\u0438 \u0441 \u043C\u0438\u043D\u0438\u043C\u0430\u043B\u044C\u043D\u044B\u043C\u0438
    \u043F\u043E\u0442\u0435\u0440\u044F\u043C\u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u0438.\r\n\r\n\u0412\u044B
    \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u0430\u043A\u043A\u0443\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u044B."
  - "\u041F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u0435 \u041A\u041F\u0414\r\n\r\n\u042D\u043B\u0435\u043A\u0442\u0440\u043E\u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0449\u0438\u0435
    \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u044B \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u0439
    \u043F\u0440\u0438\u043E\u0431\u0440\u0435\u0442\u0430\u044E\u0442 \u0431\u043E\u043B\u0435\u0435
    \u0443\u0441\u043B\u043E\u0436\u043D\u0451\u043D\u043D\u0443\u044E \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E,
    \u0430 \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043F\u0440\u043E\u0432\u043E\u0434\u043A\u0430
    \u043F\u0440\u043E\u043A\u043B\u0430\u0434\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0441 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435\u043C
    \u043C\u0435\u0442\u043E\u0434\u043E\u0432 \u043E\u043F\u0442\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u0438.
    \u042D\u0442\u0438 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044F \u043F\u0440\u0438\u0432\u043E\u0434\u044F\u0442
    \u043A \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044E \u041A\u041F\u0414.\r\n\r\n\u042D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u0438
    \u043D\u0430\u0447\u0438\u043D\u0430\u044E\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C
    \u043D\u0430 10% \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0435\u0435.
    \r\n\u042D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0438\u0441\u0442\u0435\u043C\u0430
    \u0434\u043E\u0441\u0442\u0438\u0433\u0430\u0435\u0442 110% \u043C\u043E\u0449\u043D\u043E\u0441\u0442\u0438."
  - "\u0411\u0435\u0440\u0435\u0437\u0435\u043D\u0438\u0443\u043C\u043D\u0430\u044F
    \u042D\u0421\r\n\r\n\u0414\u0430\u043D\u043D\u0430\u044F \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u044F
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u0435\u0442 \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435
    \u0430\u043D\u0442\u0438\u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0435
    \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430 \u0431\u0435\u0440\u0435\u0437\u0435\u043D\u0438\u0443\u043C\u0430
    \u0434\u043B\u044F \u0433\u0435\u043D\u0435\u0440\u0430\u0446\u0438\u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u0438,
    \u043A\u043E\u0442\u043E\u0440\u0430\u044F \u0437\u0430\u0442\u0435\u043C \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u0443\u0435\u0442\u0441\u044F
    \u0432 \u044D\u043B\u0435\u043A\u0442\u0440\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u0441 \u043F\u043E\u043C\u043E\u0449\u044C\u044E \u0442\u0443\u0440\u0431\u0438\u043D,
    \u043F\u043E\u0434\u043A\u043B\u044E\u0447\u0435\u043D\u043D\u044B\u0445 \u043A
    \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u043C
    \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u0430\u043C.\r\n\r\n\u0412\u0430\u043C
    \u0441\u0442\u0430\u043D\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430
    \u0431\u0435\u0440\u0435\u0437\u0435\u043D\u0438\u0443\u043C\u043D\u0430\u044F
    \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u044F."
  ColdDescribtion:
  - "\u041E\u0431\u043E\u0433\u0440\u0435\u0432\u0430\u0442\u0435\u043B\u0438\r\n\r\n\u041A\u043E\u043C\u043F\u0430\u043A\u0442\u043D\u0430\u044F
    \u0438 \u043D\u0430\u0434\u0435\u0436\u043D\u0430\u044F \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044F
    \u0441 \u043A\u0430\u043C\u0435\u0440\u043E\u0439 \u0441\u0436\u0438\u0433\u0430\u043D\u0438\u044F
    \u0438 \u0442\u0435\u043F\u043B\u043E\u043E\u0442\u0440\u0430\u0436\u0430\u0442\u0435\u043B\u044F\u043C\u0438
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0439
    \u043E\u0431\u043E\u0433\u0440\u0435\u0432 \u0434\u0430\u0436\u0435 \u0432 \u0441\u0430\u043C\u044B\u0445
    \u0441\u0443\u0440\u043E\u0432\u044B\u0445 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445.
    \u041F\u0440\u043E\u0441\u0442\u043E\u0442\u0430 \u044D\u043A\u0441\u043F\u043B\u0443\u0430\u0442\u0430\u0446\u0438\u0438
    \u0438 \u0432\u044B\u0441\u043E\u043A\u0430\u044F \u0442\u0435\u043F\u043B\u043E\u043E\u0442\u0434\u0430\u0447\u0430
    \u0434\u0435\u043B\u0430\u044E\u0442 \u0438\u0445 \u043D\u0435\u0437\u0430\u043C\u0435\u043D\u0438\u043C\u044B\u043C\u0438
    \u0432 \u043B\u0435\u0434\u044F\u043D\u044B\u0445 \u043F\u0440\u043E\u0441\u0442\u0440\u0430\u043D\u0441\u0442\u0432\u0430\u0445.\r\n\r\n\u0412
    \u0437\u0434\u0430\u043D\u0438\u044F\u0445 \u043F\u043E\u044F\u0432\u044F\u0442\u0441\u044F
    \u043E\u0431\u043E\u0433\u0440\u0435\u0432\u0430\u0442\u0435\u043B\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043C\u043E\u0436\u043D\u043E \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u0442\u044C,
    \u0440\u0430\u0441\u0445\u043E\u0434\u0443\u044F \u043F\u0440\u0438 \u044D\u0442\u043E\u043C
    \u0442\u043E\u043F\u043B\u0438\u0432\u043E."
  - "\u0426\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0435 \u043E\u0442\u043E\u043F\u043B\u0435\u043D\u0438\u0435\r\n\r\n\u0414\u043B\u044F
    \u043E\u0431\u043E\u0433\u0440\u0435\u0432\u0430 \u0437\u0434\u0430\u043D\u0438\u0439
    \u0431\u0443\u0434\u0435\u0442 \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u043E
    \u0438\u0437\u0431\u044B\u0442\u043E\u0447\u043D\u043E\u0435 \u0442\u0435\u043F\u043B\u043E
    \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u0439.
    \u042D\u0442\u0430 \u044D\u043D\u0435\u0440\u0433\u043E\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0430\u044F
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F \u0441\u043C\u043E\u0436\u0435\u0442
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0442\u044C \u0437\u043E\u043D\u0443
    \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u0430 \u0434\u043B\u044F \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0445
    \u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0439 \u0431\u0435\u0437
    \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0445
    \u0437\u0430\u0442\u0440\u0430\u0442.\r\n\r\n\u042D\u043B\u0435\u043A\u0442\u0440\u043E\u0441\u0442\u0430\u043D\u0446\u0438\u0438
    \u043D\u0430\u0447\u043D\u0443\u0442 \u043E\u0431\u043E\u0433\u0440\u0435\u0432\u0430\u0442\u044C
    \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0438\u0435 \u0437\u0434\u0430\u043D\u0438\u044F."
  - "\u0423\u043B\u0438\u0447\u043D\u044B\u0435 \u043E\u0442\u043E\u043F\u0438\u0442\u0435\u043B\u0438\r\n\r\n\u041F\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043B\u044F\u044E\u0442
    \u0441\u043E\u0431\u043E\u0439 \u0430\u0432\u0442\u043E\u043D\u043E\u043C\u043D\u044B\u0435
    \u0438 \u043A\u0440\u0430\u0439\u043D\u0435 \u0442\u0435\u043F\u043B\u043E\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u044B\u0435
    \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u0438, \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0449\u0438\u0435
    \u0443\u0441\u0438\u043B\u0438\u0442\u044C \u044D\u0444\u0444\u0435\u043A\u0442
    \u043E\u0442 \u0446\u0435\u043D\u0442\u0440\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    \u043E\u0442\u043E\u043F\u043B\u0435\u043D\u0438\u044F \u0432 \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u043E\u0439
    \u043E\u0431\u043B\u0430\u0441\u0442\u0438. \u041E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442
    \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u043C
    \u0442\u0435\u043F\u043B\u043E\u043C \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0438\u0435
    \u0437\u0434\u0430\u043D\u0438\u044F. \u041F\u0435\u0440\u0435\u0434 \u043D\u0430\u0447\u0430\u043B\u043E\u043C
    \u0440\u0430\u0431\u043E\u0442\u044B \u0442\u0440\u0435\u0431\u0443\u044E\u0442
    \u0440\u0430\u0441\u0442\u043E\u043F\u043A\u0438.\r\n\r\n\u0412\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
    \u0441\u0442\u043E\u0438\u0442\u044C \u0443\u043B\u0438\u0447\u043D\u044B\u0435
    \u043E\u0442\u043E\u043F\u0438\u0442\u0435\u043B\u0438."
  MedicineDescribtion:
  - "\u0423\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u0438 \u0442\u043E\u043D\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0438\u0435
    \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u044B \r\n\r\n\u0423\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0435
    \u0441\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F, \u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0435
    \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u043C\u0451\u0434\u0430. \u0421\u043F\u043E\u0441\u043E\u0431\u043D\u044B
    \u0441\u0442\u0438\u043C\u0443\u043B\u0438\u0440\u043E\u0432\u0430\u0442\u044C
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0435 \u0440\u0435\u0446\u0435\u043F\u0442\u043E\u0440\u044B
    \u0443 \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439. \u0423\u0441\u043F\u043E\u043A\u043E\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0435
    \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u044B \u0441\u043D\u0438\u0436\u0430\u044E\u0442
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0441\u0442\u0440\u0435\u0441\u0441\u0430,
    \u0430 \u0442\u043E\u043D\u0438\u0437\u0438\u0440\u0443\u044E\u0449\u0438\u0435
    \u043F\u043E\u0432\u044B\u0448\u0430\u044E\u0442 \u0431\u043E\u0434\u0440\u043E\u0441\u0442\u044C
    \u0438 \u0430\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C. \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F
    \u0442\u0449\u0430\u0442\u0435\u043B\u044C\u043D\u043E \u043F\u043E\u0434\u043E\u0431\u0440\u0430\u043D\u043D\u043E\u043C\u0443
    \u0445\u0438\u043C\u0438\u0447\u0435\u0441\u043A\u043E\u043C\u0443 \u0441\u043E\u0441\u0442\u0430\u0432\u0443,
    \u044D\u0442\u0438 \u0441\u0440\u0435\u0434\u0441\u0442\u0432\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u044B
    \u0438 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u044B \u0434\u0430\u0436\u0435
    \u0432 \u044D\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u044B\u0445
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445.\r\n\r\n\u0414\u043E\u0441\u0442\u0443\u043F\u043D\u043E
    \u0437\u0434\u0430\u043D\u0438\u0435 \u0444\u0430\u0440\u043C\u0430\u0446\u0435\u0432\u0442\u0438\u043A\u0438.\r\n\u0412\u044B
    \u043C\u043E\u0436\u0435\u0442\u0435 \u0433\u043E\u0442\u043E\u0432\u0438\u0442\u044C
    \u0443\u0441\u043F\u043E\u043A\u043E\u0438\u043D \u0438 \u0431\u043E\u0434\u0440\u0438\u043D."
  - "\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u0435 \u043A\u0430\u0447\u0435\u0441\u0442\u0432\u0430
    \u043B\u0435\u0447\u0435\u043D\u0438\u044F\r\n\r\n\u041D\u043E\u0432\u0435\u0439\u0448\u0438\u0435
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0438 \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B
    \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0440\u0430\u0441\u0448\u0438\u0440\u0438\u0442\u044C
    \u0432\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u0438 \u0432\u0440\u0430\u0447\u0430,
    \u043F\u043E\u0432\u044B\u0448\u0430\u044F \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u043B\u0435\u0447\u0435\u043D\u0438\u044F \u0438 \u0442\u043E\u0447\u043D\u043E\u0441\u0442\u044C
    \u0434\u0438\u0430\u0433\u043D\u043E\u0441\u0442\u0438\u043A\u0438 \u0431\u043E\u043B\u0435\u0437\u043D\u0435\u0439.
    \u0411\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u043F\u0435\u0440\u0435\u0434\u043E\u0432\u044B\u043C
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F\u043C, \u043C\u0435\u0434\u0438\u0446\u0438\u043D\u0441\u043A\u0438\u0435
    \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u044B \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0442\u0441\u044F
    \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u0435\u0435, \u0431\u044B\u0441\u0442\u0440\u0435\u0435
    \u0438 \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u0438\u0432\u043D\u0435\u0435.\r\n\r\n\u041C\u0435\u0434\u0432\u0435\u0434\u0438
    \u0432 \u043C\u0435\u0434\u043F\u0443\u043D\u043A\u0442\u0435 \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0442
    \u043D\u0430 50% \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0435\u0435"
  - "\u041F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u044B \u043F\u0440\u043E\u0442\u0438\u0432
    \u0441\u043F\u044F\u0447\u043A\u0438 \u0438 \u0441\u0442\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u044B\r\n\r\n\u0421\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0435
    \u043D\u0430 \u043E\u0441\u043D\u043E\u0432\u0435 \u043C\u0451\u0434\u0430, \u044D\u0442\u0438
    \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u044B \u0431\u043E\u0440\u044E\u0442\u0441\u044F
    \u0441 \u0440\u0443\u0434\u0438\u043C\u0435\u043D\u0442\u0430\u0440\u043D\u044B\u043C
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u043C \u0441\u043F\u044F\u0447\u043A\u0438,
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044F \u043C\u0435\u0434\u0432\u0435\u0434\u044F\u043C
    \u0435\u0433\u043E \u0438\u0433\u043D\u043E\u0440\u0438\u0440\u043E\u0432\u0430\u0442\u044C.
    \u041F\u043E\u0431\u043E\u0447\u043D\u044B\u043C \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u043E\u043C
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u0441\u0442\u0430\u043B
    \u0441\u0442\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440, \u043A\u043E\u0442\u043E\u0440\u044B\u0439
    \u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442
    \u0444\u0438\u0437\u0438\u0447\u0435\u0441\u043A\u0438\u0435 \u0438 \u0443\u043C\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0435
    \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u0438, \u0441\u0442\u0430\u043D\u043E\u0432\u044F\u0441\u044C
    \u043D\u0435\u0437\u0430\u043C\u0435\u043D\u0438\u043C\u044B\u043C \u0432 \u044D\u043A\u0441\u0442\u0440\u0435\u043D\u043D\u044B\u0445
    \u0441\u0438\u0442\u0443\u0430\u0446\u0438\u044F\u0445.\r\n\r\n\u0412\u044B \u0441\u043C\u043E\u0436\u0435\u0442\u0435
    \u0441\u043E\u0437\u0434\u0430\u0432\u0430\u0442\u044C \u043F\u0440\u0435\u043F\u0430\u0440\u0430\u0442\u044B
    \u043F\u0440\u043E\u0442\u0438\u0432 \u0441\u043F\u044F\u0447\u043A\u0438 \u0438
    \u0441\u0442\u0438\u043C\u0443\u043B\u044F\u0442\u043E\u0440\u044B."
  TravelDescribtion:
  - "\u0423\u0442\u0435\u043F\u043B\u0451\u043D\u043D\u043E\u0435 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435
    \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u043E\u0432\r\n\r\n\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E
    \u0440\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0430\u043D\u043D\u043E\u0435
    \u0433\u0438\u0434\u0440\u043E\u0444\u043E\u0431\u043D\u043E\u0435 \u0441\u043D\u0430\u0440\u044F\u0436\u0435\u043D\u0438\u0435
    \u0441 \u0443\u0441\u0438\u043B\u0435\u043D\u043D\u043E\u0439 \u0442\u0435\u043F\u043B\u043E\u0438\u0437\u043E\u043B\u044F\u0446\u0438\u0435\u0439
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u0435\u0442 \u0437\u0430\u0449\u0438\u0442\u0443
    \u043E\u0442 \u0438\u0437\u0431\u044B\u0442\u043E\u0447\u043D\u043E\u0439 \u0432\u043B\u0430\u0436\u043D\u043E\u0441\u0442\u0438
    \u0438 \u044D\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u043E
    \u043D\u0438\u0437\u043A\u0438\u0445 \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440.
    \u042D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442 \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u0430\u043C
    \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E \u0432\u044B\u043F\u043E\u043B\u043D\u044F\u0442\u044C
    \u0437\u0430\u0434\u0430\u0447\u0438 \u0434\u0430\u0436\u0435 \u0432 \u0441\u0430\u043C\u044B\u0445
    \u0441\u0443\u0440\u043E\u0432\u044B\u0445 \u043A\u043B\u0438\u043C\u0430\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445.\r\n\r\n\u041C\u0435\u0434\u0432\u0435\u0434\u0438
    \u0432 \u0441\u043E\u0441\u0442\u0430\u0432\u0435 \u043E\u0442\u0440\u044F\u0434\u0430
    \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0438 \u0441\u0442\u0430\u043D\u0443\u0442
    \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u0435\u0435 \u043A \u0445\u043E\u043B\u043E\u0434\u0443
    \u043D\u0430 4 \u0435\u0434\u0438\u043D\u0438\u0446\u044B."
  - "\u0421\u043D\u0435\u0433\u043E\u0445\u043E\u0434\u044B\r\n\r\n\u041D\u0430\u0434\u0451\u0436\u043D\u044B\u0439
    \u0442\u0440\u0430\u043D\u0441\u043F\u043E\u0440\u0442 \u0434\u043B\u044F \u043F\u0440\u0435\u043E\u0434\u043E\u043B\u0435\u043D\u0438\u044F
    \u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u0440\u0430\u0441\u0441\u0442\u043E\u044F\u043D\u0438\u0439
    \u0432 \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445 \u0437\u0430\u0441\u043D\u0435\u0436\u0435\u043D\u043D\u043E\u0439
    \u043B\u043E\u043A\u0430\u0446\u0438\u0438. \u0412\u043E\u0441\u0441\u043E\u0437\u0434\u0430\u043D\u043D\u044B\u0435
    \u043F\u043E \u043E\u0431\u0440\u0430\u0437\u0443 \u0438 \u043F\u043E\u0434\u043E\u0431\u0438\u044E
    \u0441\u043D\u0435\u0433\u043E\u0445\u043E\u0434\u043E\u0432 \u0441 \u0411\u0435\u0440\u043B\u043E\u0433\u0438,
    \u043E\u043D\u0438 \u0431\u044B\u043B\u0438 \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u044B
    \u0434\u043B\u044F \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u043C\u043E\u0441\u0442\u0438
    \u0438 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u0438,
    \u0447\u0442\u043E \u0434\u0435\u043B\u0430\u0435\u0442 \u0438\u0445 \u043D\u0435\u0437\u0430\u043C\u0435\u043D\u0438\u043C\u044B\u043C\u0438
    \u0434\u043B\u044F \u0440\u0430\u0437\u0432\u0435\u0434\u0447\u0438\u043A\u043E\u0432.\r\n\r\n\u041D\u0430
    \u0437\u0430\u0432\u043E\u0434\u0435 \u0440\u043E\u0431\u043E\u0442\u043E\u0442\u0435\u0445\u043D\u0438\u043A\u0438
    \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430
    \u0441\u0431\u043E\u0440\u043A\u0430 \u0441\u043D\u0435\u0433\u043E\u0445\u043E\u0434\u043E\u0432.\r\n\u041E\u0442\u0440\u044F\u0434\u044B
    \u0440\u0430\u0437\u0432\u0435\u0434\u043A\u0438 \u043C\u043E\u0436\u043D\u043E
    \u0443\u043A\u043E\u043C\u043F\u043B\u0435\u043A\u0442\u043E\u0432\u0430\u0442\u044C
    \u0441\u043D\u0435\u0433\u043E\u0445\u043E\u0434\u043E\u043C \u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C
    \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C \u0438\u0445 \u043F\u0435\u0440\u0435\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
    \u043D\u0430 10 \u0435\u0434\u0438\u043D\u0438\u0446.\r\n\u0412\u0430\u043C \u0441\u0442\u0430\u043D\u0435\u0442
    \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D \u043F\u0435\u0440\u0441\u043E\u043D\u0430\u043B\u044C\u043D\u044B\u0439
    \u0441\u043D\u0435\u0433\u043E\u0445\u043E\u0434 \u043A\u0430\u043F\u0438\u0442\u0430\u043D\u0430."
  - "\u041A\u043E\u0441\u043C\u043E\u043B\u0451\u0442\r\n\r\n\u041A\u0430\u0436\u0434\u044B\u0439
    \u0447\u043B\u0435\u043D \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u0438
    \u043C\u0435\u0447\u0442\u0430\u0435\u0442 \u0432\u0435\u0440\u043D\u0443\u0442\u044C\u0441\u044F
    \u0434\u043E\u043C\u043E\u0439 \u043D\u0430 \u0440\u043E\u0434\u043D\u0443\u044E
    \u043F\u043B\u0430\u043D\u0435\u0442\u0443 \u0411\u0435\u0440\u043B\u043E\u0433\u0430.
    \u0412 \u0445\u043E\u0434\u0435 \u043D\u0435\u0434\u0430\u0432\u043D\u0438\u0445
    \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u0439 \u043D\u0430\u0448\u0438
    \u0443\u0447\u0435\u043D\u044B\u0435 \u0441\u043C\u043E\u0433\u043B\u0438 \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F,
    \u043A\u0430\u043A \u0437\u0430\u043D\u043E\u0432\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u044C
    \u043A\u0440\u043E\u0442\u043E\u0432\u0443\u044E \u043D\u043E\u0440\u0443 \u043F\u0440\u0438
    \u043F\u043E\u043C\u043E\u0449\u0438 \u0441\u0432\u043E\u0439\u0441\u0442\u0432
    \u0431\u0435\u0440\u0435\u0437\u0435\u043D\u0438\u0443\u043C\u0430. \u041D\u0435
    \u0445\u0432\u0430\u0442\u0430\u0435\u0442 \u0442\u043E\u043B\u044C\u043A\u043E
    \u043A\u043E\u0441\u043C\u043E\u043B\u0451\u0442\u0430. \r\n\r\n\u0412\u044B
    \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u043A\u043E\u0441\u043C\u043E\u043B\u0451\u0442."
  HouseholdDescribtion:
  - "\u041C\u043D\u043E\u0433\u043E\u044D\u0442\u0430\u0436\u043D\u043E\u0435 \u0437\u0434\u0430\u043D\u0438\u0435\r\n\r\n\u041C\u043D\u043E\u0433\u043E\u0444\u0443\u043D\u043A\u0446\u0438\u043E\u043D\u0430\u043B\u044C\u043D\u043E\u0435
    \u0441\u043E\u043E\u0440\u0443\u0436\u0435\u043D\u0438\u0435, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0435
    \u0432\u043C\u0435\u0441\u0442\u0438\u0442\u044C \u0432 \u0441\u0435\u0431\u044F
    \u0431\u043E\u043B\u044C\u0448\u043E\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439. \u0418\u043C\u0435\u0435\u0442
    \u043F\u0440\u043E\u0434\u0443\u043C\u0430\u043D\u043D\u0443\u044E \u043A\u043E\u043D\u0441\u0442\u0440\u0443\u043A\u0446\u0438\u044E
    \u0438 \u0442\u0435\u043F\u043B\u043E\u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044E,
    \u0431\u043B\u0430\u0433\u043E\u0434\u0430\u0440\u044F \u0447\u0435\u043C\u0443
    \u043B\u0435\u0433\u043A\u043E \u043E\u0442\u0430\u043F\u043B\u0438\u0432\u0430\u0435\u0442\u0441\u044F,
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F \u043A\u043E\u043C\u0444\u043E\u0440\u0442
    \u0441\u0432\u043E\u0438\u043C \u043E\u0431\u0438\u0442\u0430\u0442\u0435\u043B\u044F\u043C.\r\n\r\n\u0412\u044B
    \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u043C\u043D\u043E\u0433\u043E\u044D\u0442\u0430\u0436\u043A\u0443."
  - "\u0423\u0442\u0435\u043F\u043B\u0435\u043D\u0438\u0435 \u0436\u0438\u043B\u0438\u0449\r\n\r\n\u0418\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u0435
    \u043D\u043E\u0432\u0435\u0439\u0448\u0438\u0445 \u0442\u0435\u043F\u043B\u043E\u0438\u0437\u043E\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u044B\u0445
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u043E\u0432 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u044C
    \u0436\u0438\u043B\u044B\u0445 \u043F\u043E\u0441\u0442\u0440\u043E\u0435\u043A
    \u043A \u0445\u043E\u043B\u043E\u0434\u0443. \u042D\u0442\u0438 \u043D\u0435\u0431\u043E\u043B\u044C\u0448\u0438\u0435,
    \u043D\u043E \u043D\u0443\u0436\u043D\u044B\u0435 \u0438 \u043F\u0440\u043E\u0434\u0443\u043C\u0430\u043D\u043D\u044B\u0435
    \u0443\u043B\u0443\u0447\u0448\u0435\u043D\u0438\u044F \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0442
    \u0441\u0434\u0435\u043B\u0430\u0442\u044C \u0436\u0438\u043B\u0438\u0449\u0430
    \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u043C\u0438 \u043A \u043D\u0438\u0437\u043A\u0438\u043C
    \u0442\u0435\u043C\u043F\u0435\u0440\u0430\u0442\u0443\u0440\u0430\u043C, \u0430
    \u0442\u0430\u043A\u0436\u0435 \u0431\u043E\u043B\u0435\u0435 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u044B\u043C\u0438
    \u0434\u043B\u044F \u0438\u0445 \u043E\u0431\u0438\u0442\u0430\u0442\u0435\u043B\u0435\u0439.\r\n\r\n\u0416\u0438\u043B\u0438\u0449\u0430
    \u0441\u0442\u0430\u043D\u0443\u0442 \u0442\u0435\u043F\u043B\u0435\u0435 \u043D\u0430
    2 \u0435\u0434\u0438\u043D\u0438\u0446\u044B."
  - "\u041E\u0441\u043E\u0431\u043D\u044F\u043A\r\n\r\n\xAB\u041C\u043E\u0439 \u0434\u043E\u043C
    - \u043C\u043E\u044F \u043A\u0440\u0435\u043F\u043E\u0441\u0442\u044C\xBB - \u0438\u043C\u0435\u043D\u043D\u043E
    \u0442\u0430\u043A\u0438\u043C\u0438 \u0441\u043B\u043E\u0432\u0430\u043C\u0438
    \u043C\u043E\u0436\u043D\u043E \u043E\u043F\u0438\u0441\u0430\u0442\u044C \u044D\u0442\u043E
    \u043C\u0430\u0441\u0441\u0438\u0432\u043D\u043E\u0435 \u0437\u0434\u0430\u043D\u0438\u0435,
    \u0441\u043E\u0447\u0435\u0442\u0430\u044E\u0449\u0435\u0435 \u0432 \u0441\u0435\u0431\u0435
    \u043D\u0430\u0434\u0451\u0436\u043D\u043E\u0441\u0442\u044C \u0438 \u0440\u043E\u0441\u043A\u043E\u0448\u044C.
    \u041F\u0440\u043E\u0434\u0443\u043C\u0430\u043D\u043D\u0430\u044F \u043F\u043B\u0430\u043D\u0438\u0440\u043E\u0432\u043A\u0430
    \u0438 \u0443\u0441\u0438\u043B\u0435\u043D\u043D\u0430\u044F \u0442\u0435\u043F\u043B\u043E\u0438\u0437\u043E\u043B\u044F\u0446\u0438\u044F
    \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044E\u0442 \u0436\u0438\u0442\u0435\u043B\u044F\u043C
    \u043E\u0441\u043E\u0431\u043D\u044F\u043A\u0430 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u044B\u0435
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F \u0438 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u0443\u044E
    \u0437\u0430\u0449\u0438\u0442\u0443 \u043E\u0442 \u0445\u043E\u043B\u043E\u0434\u0430.\r\n\r\n\u0412\u044B
    \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u043E\u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u043E\u0441\u043E\u0431\u043D\u044F\u043A."
  FoodDescribtion:
  - "\u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u0445\u043B\u0430\u0434\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438
    \u0438 \u043F\u0440\u043E\u0434\u0443\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438\r\n\r\n\u0411\u0438\u043E\u0438\u043D\u0436\u0435\u043D\u0435\u0440\u044B
    \u043C\u043E\u0434\u0438\u0444\u0438\u0446\u0438\u0440\u043E\u0432\u0430\u043B\u0438
    \u0433\u0435\u043D\u044B \u0445\u043E\u043B\u043E\u0434\u043E\u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u043E\u0441\u0442\u0438
    \u0443 \u0446\u0432\u0435\u0442\u043A\u043E\u0432\u044B\u0445 \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u0432\u044B\u0432\u0435\u043B\u0438 \u043D\u043E\u0432\u044B\u0439
    \u043F\u043E\u0434\u0432\u0438\u0434 \u043F\u0447\u0451\u043B, \u0441\u043F\u043E\u0441\u043E\u0431\u043D\u044B\u0445
    \u0432\u044B\u0436\u0438\u0432\u0430\u0442\u044C \u0432 \u044D\u043A\u0441\u0442\u0440\u0435\u043C\u0430\u043B\u044C\u043D\u044B\u0445
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F\u0445.\r\n\r\n\u041F\u0430\u0441\u0435\u043A\u0438
    \u0441\u0442\u0430\u043D\u0443\u0442 \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u0435\u0435
    \u043A \u0445\u043E\u043B\u043E\u0434\u0443 \u043D\u0430 3 \u0435\u0434\u0438\u043D\u0438\u0446\u044B."
  - "\u042D\u043A\u043E\u0441\u0438\u0441\u0442\u0435\u043C\u043D\u0430\u044F \u043F\u0430\u0441\u0435\u043A\u0430\r\n\r\n\u041D\u043E\u0432\u0435\u0439\u0448\u0438\u0439
    \u0432\u0438\u0434 \u043F\u0430\u0441\u0435\u043A\u0438 \u0441 \u0438\u0441\u043A\u0443\u0441\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u043C
    \u043A\u043B\u0438\u043C\u0430\u0442\u043E\u043C. \u0414\u043B\u044F \u0434\u0430\u043D\u043D\u043E\u0433\u043E
    \u0432\u0438\u0434\u0430 \u043F\u0430\u0441\u0435\u043A\u0438 \u043F\u0447\u0451\u043B\u0430\u043C
    \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044F
    \u0438\u043C\u0435\u0442\u044C \u0433\u0435\u043D\u044B \u0445\u043B\u0430\u0434\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438,
    \u043F\u043E\u044D\u0442\u043E\u043C\u0443 \u043E\u043D\u0438 \u0431\u044B\u043B\u0438
    \u0437\u0430\u043C\u0435\u043D\u0435\u043D\u044B \u043D\u0430 \u0433\u0435\u043D\u044B
    \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0433\u043E \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430
    \u043C\u0451\u0434\u0430. \u0414\u043B\u044F \u0434\u0430\u043D\u043D\u043E\u0433\u043E
    \u0437\u0434\u0430\u043D\u0438\u044F \u0442\u0440\u0435\u0431\u0443\u044E\u0442\u0441\u044F
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0435 \u044D\u043D\u0435\u0440\u0433\u043E\u0437\u0430\u0442\u0440\u0430\u0442\u044B,
    \u043A\u043E\u0442\u043E\u0440\u044B\u0435 \u043A\u043E\u043C\u043F\u0435\u043D\u0441\u0438\u0440\u0443\u044E\u0442\u0441\u044F
    \u0435\u0433\u043E \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C\u044E.\r\n\r\n\u0412\u0430\u043C
    \u0441\u0442\u0430\u043D\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430
    \u044D\u043A\u043E\u0441\u0438\u0441\u0442\u0435\u043C\u043D\u0430\u044F \u043F\u0430\u0441\u0435\u043A\u0430."
  - "\u041A\u0438\u0431\u0435\u0440\u043F\u0430\u0441\u0435\u043A\u0430\r\n\r\n\u0423\u0447\u0435\u043D\u044B\u043C\u0438
    \u0431\u044B\u043B\u0430 \u0432\u043D\u0435\u0434\u0440\u0435\u043D\u0430 \u0438\u043D\u043D\u043E\u0432\u0430\u0446\u0438\u043E\u043D\u043D\u0430\u044F
    \u0437\u0430\u043C\u0435\u043D\u0430 \u0442\u0440\u0430\u0434\u0438\u0446\u0438\u043E\u043D\u043D\u044B\u043C
    \u043F\u0447\u0451\u043B\u0430\u043C \u2014 \u043A\u0438\u0431\u0435\u0440\u043F\u0447\u0451\u043B\u044B.
    \u041E\u043D\u0438 \u0432\u044B\u043D\u043E\u0441\u043B\u0438\u0432\u044B, \u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B
    \u043A \u0445\u043E\u043B\u043E\u0434\u0443 \u0438 \u0441\u043E\u0437\u0434\u0430\u044E\u0442
    \u043C\u0451\u0434 \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0435\u0435
    \u0441\u0432\u043E\u0438\u0445 \u043E\u0440\u0433\u0430\u043D\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0441\u043E\u0431\u0440\u0430\u0442\u044C\u0435\u0432. \u041D\u0435\u0441\u043C\u043E\u0442\u0440\u044F
    \u043D\u0430 \u0432\u044B\u0441\u043E\u043A\u0443\u044E \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0447\u043D\u043E\u0441\u0442\u044C
    \u0434\u0430\u043D\u043D\u043E\u0433\u043E \u0432\u0438\u0434\u0430 \u043F\u0430\u0441\u0435\u043A\u0438,
    \u0432\u0441\u0435 \u0435\u0449\u0435 \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u0435\u0442\u0441\u044F
    \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E\u0441\u0442\u044C \u0432 \u0446\u0432\u0435\u0442\u043A\u043E\u0432\u044B\u0445
    \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u044F\u0445 \u0434\u043B\u044F \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0430
    \u043C\u0451\u0434\u0430.\r\n\r\n\u0412\u0430\u043C \u0441\u0442\u0430\u043D\u0435\u0442
    \u0434\u043E\u0441\u0442\u0443\u043F\u043D\u0430 \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0430
    \u043A\u0438\u0431\u0435\u0440\u043F\u0430\u0441\u0435\u043A\u0438.\r\n\u0412\u044B
    \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u044C
    \u043A\u0438\u0431\u0435\u0440\u043F\u0447\u0451\u043B \u043D\u0430 \u0437\u0430\u0432\u043E\u0434\u0435
    \u0440\u043E\u0431\u043E\u0442\u043E\u0442\u0435\u0445\u043D\u0438\u043A\u0438."
  ProductionDescribtion:
  - "\u0417\u0430\u0432\u043E\u0434 \u044D\u043D\u0435\u0440\u0433\u043E\u043C\u0451\u0434\u0430\r\n\r\n\u0421\u043F\u0435\u0446\u0438\u0430\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u0435
    \u0437\u0434\u0430\u043D\u0438\u0435, \u0432 \u043A\u043E\u0442\u043E\u0440\u043E\u043C
    \u043C\u0451\u0434 \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0430\u0435\u0442\u0441\u044F
    \u043C\u043D\u043E\u0433\u043E\u0441\u0442\u0443\u043F\u0435\u043D\u0447\u0430\u0442\u043E\u0439
    \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0435 \u0434\u043B\u044F \u043F\u0440\u0435\u043E\u0431\u0440\u0430\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0432 \u0441\u0432\u043E\u044E \u044D\u043D\u0435\u0440\u0433\u043E\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u0443\u044E
    \u0444\u043E\u0440\u043C\u0443 - \u044D\u043D\u0435\u0440\u0433\u043E\u043C\u0451\u0434.
    \u041F\u0440\u0438 \u043F\u043E\u043C\u043E\u0449\u0438 \u044D\u0442\u043E\u0433\u043E
    \u044D\u043D\u0435\u0440\u0433\u0435\u0442\u0438\u0447\u0435\u0441\u043A\u043E\u0433\u043E
    \u0440\u0435\u0441\u0443\u0440\u0441\u0430 \u043C\u043E\u0436\u043D\u043E \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0442\u044C
    \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u044D\u043D\u0435\u0440\u0433\u0438\u0435\u0439
    \u0432\u0441\u044E \u043A\u043E\u043B\u043E\u043D\u0438\u044E.\r\n\r\n\u0412\u043E\u0437\u043C\u043E\u0436\u043D\u043E\u0441\u0442\u044C
    \u0441\u0442\u0440\u043E\u0438\u0442\u044C \u0437\u0430\u0432\u043E\u0434 \u044D\u043D\u0435\u0440\u0433\u043E\u043C\u0451\u0434\u0430."
  - "\u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u041A\u041F\u0414\r\n\r\n\u041E\u043F\u0442\u0438\u043C\u0438\u0437\u0430\u0446\u0438\u044F
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0441\u0442\u0432\u0435\u043D\u043D\u044B\u0445
    \u043F\u0440\u043E\u0446\u0435\u0441\u0441\u043E\u0432 \u0438 \u0432\u043D\u0435\u0434\u0440\u0435\u043D\u0438\u0435
    \u043F\u0435\u0440\u0435\u0434\u043E\u0432\u044B\u0445 \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u0439
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u043F\u043E\u0432\u044B\u0441\u0438\u0442\u044C \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C.
    \u0423\u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u0441\u0442\u0432\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u0441\u0438\u0441\u0442\u0435\u043C\u044B \u043C\u0438\u043D\u0438\u043C\u0438\u0437\u0438\u0440\u0443\u044E\u0442
    \u043F\u043E\u0442\u0435\u0440\u0438 \u044D\u043D\u0435\u0440\u0433\u0438\u0438
    \u0438 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432, \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0432\u0430\u044F
    \u0441\u0442\u0430\u0431\u0438\u043B\u044C\u043D\u044B\u0439 \u0440\u043E\u0441\u0442
    \u043F\u0440\u043E\u0438\u0437\u0432\u043E\u0434\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u043D\u0430 \u0437\u0430\u0432\u043E\u0434\u0430\u0445.\r\n\r\n\u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u0437\u0430\u0432\u043E\u0434\u043E\u0432 +25%"
  - "\u0417\u0430\u0432\u043E\u0434 \u0434\u0432\u043E\u0439\u043D\u043E\u0439 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438
    \u0431\u0435\u0440\u0435\u0437\u0435\u043D\u0438\u0443\u043C\u0430 \r\n\r\n\u0412
    \u0434\u0430\u043D\u043D\u043E\u043C \u0437\u0434\u0430\u043D\u0438\u0438 \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442
    \u043E\u0447\u0438\u0441\u0442\u043A\u0430 \u0438 \u0430\u043A\u0442\u0438\u0432\u0438\u0437\u0430\u0446\u0438\u044F
    \u043C\u0438\u043D\u0435\u0440\u0430\u043B\u0430 \u0431\u0435\u0440\u0435\u0437\u0435\u043D\u0438\u0443\u043C\u0430.
    \u0417\u0430\u0442\u0435\u043C \u043E\u043D \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u0430\u0435\u0442\u0441\u044F
    \u0432\u043E\u0437\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044E \u0441\u0438\u043B\u044C\u043D\u043E\u0433\u043E
    \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u043C\u0430\u0433\u043D\u0438\u0442\u043D\u043E\u0433\u043E
    \u043F\u043E\u043B\u044F, \u0447\u0442\u043E \u0437\u043D\u0430\u0447\u0438\u0442\u0435\u043B\u044C\u043D\u043E
    \u0443\u0441\u0438\u043B\u044F\u0435\u0442 \u0435\u0433\u043E \u0430\u043D\u0442\u0438\u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0435
    \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430. \u041C\u0438\u043D\u0435\u0440\u0430\u043B,
    \u043F\u043E\u0434\u0432\u0435\u0440\u0433\u043D\u0443\u0442\u044B\u0439 \u0434\u0430\u043D\u043D\u043E\u0439
    \u043F\u0440\u043E\u0446\u0435\u0434\u0443\u0440\u0435, \u0441\u0442\u0430\u043D\u043E\u0432\u0438\u0442\u0441\u044F
    \u043F\u0440\u0438\u0433\u043E\u0434\u043D\u044B\u043C \u0434\u043B\u044F \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u043E\u0432\u0430\u043D\u0438\u044F
    \u0432 \u043F\u0435\u0440\u0435\u0434\u043E\u0432\u044B\u0445 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044F\u0445 (\u043D\u0430\u043F\u0440\u0438\u043C\u0435\u0440
    \u0432 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u044F\u0445 \u0438 \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
    \u0433\u0435\u043D\u0435\u0440\u0430\u0442\u043E\u0440\u0430\u0445). \u041F\u0440\u043E\u0446\u0435\u0441\u0441
    \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438 \u0442\u0440\u0435\u0431\u0443\u0435\u0442
    \u0431\u043E\u043B\u044C\u0448\u0438\u0445 \u0437\u0430\u0442\u0440\u0430\u0442
    \u044D\u043B\u0435\u043A\u0442\u0440\u043E\u044D\u043D\u0435\u0440\u0433\u0438\u0438,
    \u043D\u043E \u043E\u043D \u0442\u043E\u0433\u043E \u0441\u0442\u043E\u0438\u0442.\r\n\r\n\u0412\u044B
    \u0441\u043C\u043E\u0436\u0435\u0442\u0435 \u0441\u0442\u0440\u043E\u0438\u0442\u044C
    \u0437\u0430\u0432\u043E\u0434 \u0434\u0432\u043E\u0439\u043D\u043E\u0439 \u043E\u0431\u0440\u0430\u0431\u043E\u0442\u043A\u0438
    \u0431\u0435\u0440\u0435\u0437\u0435\u043D\u0438\u0443\u043C\u0430."
  MiningDescribtion:
  - "\u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u0445\u043B\u0430\u0434\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438
    \u0438 \u043E\u0431\u044A\u0435\u043C\u0430 \u0434\u043E\u0431\u044B\u0447\u0438\r\n\r\n\u0423\u043B\u0443\u0447\u0448\u0435\u043D\u043D\u044B\u0435
    \u0442\u0435\u043F\u043B\u043E\u0438\u0437\u043E\u043B\u044F\u0446\u0438\u043E\u043D\u043D\u044B\u0435
    \u043C\u0430\u0442\u0435\u0440\u0438\u0430\u043B\u044B \u0438 \u0441\u0438\u0441\u0442\u0435\u043C\u044B
    \u043E\u0431\u043E\u0433\u0440\u0435\u0432\u0430 \u0437\u0430\u0449\u0438\u0449\u0430\u044E\u0442
    \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439 \u043E\u0442 \u0445\u043E\u043B\u043E\u0434\u0430
    \u043D\u0430 \u0442\u043E\u0447\u043A\u0430\u0445 \u0434\u043E\u0431\u044B\u0447\u0438.
    \u041E\u0434\u043D\u043E\u0432\u0440\u0435\u043C\u0435\u043D\u043D\u043E \u043C\u043E\u0434\u0435\u0440\u043D\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B, \u0442\u0430\u043A\u0438\u0435
    \u043A\u0430\u043A \u0442\u0435\u0440\u043C\u043E\u0443\u0441\u0442\u043E\u0439\u0447\u0438\u0432\u044B\u0435
    \u0431\u0443\u0440\u044B \u0438 \u0430\u0432\u0442\u043E\u043C\u0430\u0442\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u044B\u0435
    \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u044B, \u0443\u0441\u043A\u043E\u0440\u044F\u044E\u0442
    \u0434\u043E\u0431\u044B\u0447\u0443 \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432,
    \u043F\u043E\u0432\u044B\u0448\u0430\u044F \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0441\u0442\u044C
    \u0440\u0430\u0431\u043E\u0442.\r\n\r\n\u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435
    \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438
    \u043D\u0430 10%\r\n\u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435
    \u0445\u043B\u0430\u0434\u043E\u0441\u0442\u043E\u0439\u043A\u043E\u0441\u0442\u0438
    \u043D\u0430 3 \u0435\u0434\u0438\u043D\u0438\u0446\u044B"
  - "\u0414\u043E\u0431\u044B\u0447\u0430 \u0431\u0435\u0440\u0435\u0437\u0435\u043D\u0438\u0443\u043C\u0430\r\n\r\n\u0418\u0437-\u0437\u0430
    \u043D\u0435\u043F\u0440\u0435\u0434\u0441\u043A\u0430\u0437\u0443\u0435\u043C\u044B\u0445
    \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0445
    \u0438\u0441\u043A\u0430\u0436\u0435\u043D\u0438\u0439 \u0440\u0430\u0431\u043E\u0442\u0430
    \u0441 \u0431\u0435\u0440\u0435\u0437\u0435\u043D\u0438\u0443\u043C\u043E\u043C
    \u043E\u0441\u0442\u0430\u0451\u0442\u0441\u044F \u043A\u0440\u0430\u0439\u043D\u0435
    \u043E\u043F\u0430\u0441\u043D\u043E\u0439. \u0423\u0447\u0451\u043D\u044B\u0435
    \u0440\u0430\u0437\u0440\u0430\u0431\u0430\u0442\u044B\u0432\u0430\u044E\u0442
    \u043A\u0430\u0440\u044C\u0435\u0440\u043D\u044B\u0435 \u0443\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0438
    \u0441 \u0434\u0438\u0441\u0442\u0430\u043D\u0446\u0438\u043E\u043D\u043D\u044B\u043C
    \u0443\u043F\u0440\u0430\u0432\u043B\u0435\u043D\u0438\u0435\u043C, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
    \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E
    \u0438\u0437\u0432\u043B\u0435\u043A\u0430\u0442\u044C \u043C\u0438\u043D\u0435\u0440\u0430\u043B,
    \u043C\u0438\u043D\u0438\u043C\u0438\u0437\u0438\u0440\u0443\u044F \u0440\u0438\u0441\u043A\u0438
    \u0434\u043B\u044F \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439 \u0438 \u043E\u043A\u0440\u0443\u0436\u0430\u044E\u0449\u0435\u0439
    \u0441\u0440\u0435\u0434\u044B.\r\n\r\n\u041A\u0430\u0440\u044C\u0435\u0440 \u0431\u0435\u0440\u0435\u0437\u0435\u043D\u0438\u0443\u043C\u0430
    \u0441\u0442\u0430\u043D\u0435\u0442 \u0434\u043E\u0441\u0442\u0443\u043F\u0435\u043D
    \u0434\u043B\u044F \u043F\u043E\u0441\u0442\u0440\u043E\u0439\u043A\u0438."
  - "\u0423\u0432\u0435\u043B\u0438\u0447\u0435\u043D\u0438\u0435 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u0430
    \u0438 \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u0438 \u0434\u043E\u0431\u044B\u0447\u0438\r\n\r\n\u0414\u043B\u044F
    \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u0438\u044F \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438
    \u0434\u043E\u0431\u044B\u0432\u0430\u044E\u0449\u0435\u0439 \u043F\u0440\u043E\u043C\u044B\u0448\u043B\u0435\u043D\u043D\u043E\u0441\u0442\u0438
    \u0443\u0447\u0451\u043D\u044B\u0435 \u0432\u043D\u0435\u0434\u0440\u044F\u044E\u0442
    \u0431\u0435\u0440\u0435\u0437\u0435\u043D\u0438\u0443\u043C \u0432 \u0438\u043D\u0441\u0442\u0440\u0443\u043C\u0435\u043D\u0442\u044B,
    \u0438\u0441\u043F\u043E\u043B\u044C\u0437\u0443\u044F \u0435\u0433\u043E \u0430\u043D\u0442\u0438\u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0435
    \u0441\u0432\u043E\u0439\u0441\u0442\u0432\u0430. \u042D\u0442\u043E \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u0435\u0442
    \u0443\u0441\u043A\u043E\u0440\u0438\u0442\u044C \u043F\u0440\u043E\u0446\u0435\u0441\u0441
    \u0434\u043E\u0431\u044B\u0447\u0438 \u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0442\u044C
    \u043E\u0431\u044A\u0451\u043C\u044B \u0438\u0437\u0432\u043B\u0435\u043A\u0430\u0435\u043C\u044B\u0445
    \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432, \u0434\u0435\u043B\u0430\u044F
    \u0442\u0435\u0445\u043D\u043E\u043B\u043E\u0433\u0438\u044E \u043F\u0435\u0440\u0441\u043F\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0439
    \u0438 \u0432\u044B\u0441\u043E\u043A\u043E\u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0439.\r\n\r\n\u042D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u0434\u043E\u0431\u044B\u0447\u0438 +25%"
