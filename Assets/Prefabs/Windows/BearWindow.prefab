  m_Text: "\u041F\u0440\u043E\u0436\u0438\u0432\u0430\u043D\u0438\u0435: \u043E\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442"
--- !u!114 &9130511134978412599
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2075048802447801644}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 87d38dc7995568443b6ae76432516340, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Info: "\u041A\u0440\u044B\u0448\u0430 \u043D\u0430\u0434 \u0433\u043E\u043B\u043E\u0432\u043E\u0439
    - \u043E\u0434\u043D\u0430 \u0438\u0437 \u0431\u0430\u0437\u043E\u0432\u044B\u0445
    \u043F\u043E\u0442\u0440\u0435\u0431\u043D\u043E\u0441\u0442\u0435\u0439 \u043C\u0435\u0434\u0432\u0435\u0434\u044F.
    \u0411\u0435\u0437 \u0436\u0438\u043B\u0438\u0449\u0430 \u043C\u0435\u0434\u0432\u0435\u0434\u044C
    \u043D\u0435 \u0441\u043C\u043E\u0436\u0435\u0442 \u043E\u0442\u0434\u044B\u0445\u0430\u0442\u044C,
    \u043F\u043E\u043D\u0438\u0436\u0430\u0442\u044C \u0443\u0440\u043E\u0432\u0435\u043D\u044C
    \u0441\u0432\u043E\u0435\u0433\u043E \u0441\u0442\u0440\u0435\u0441\u0441\u0430,
    \u0430 \u0442\u0430\u043A\u0436\u0435 \u0431\u0443\u0434\u0435\u0442 \u043A\u0440\u0430\u0439\u043D\u0435
    \u0443\u044F\u0437\u0432\u0438\u043C \u043A \u0445\u043E\u043B\u043E\u0434\u0443."
