--- !u!114 &1433301410954585748
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 7778668534644920061}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 87d38dc7995568443b6ae76432516340, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Info: "\u0417\u043D\u0430\u0447\u0435\u043D\u0438\u0435 \u043E\u043F\u044B\u0442\u0430
    \u043C\u0435\u0434\u0432\u0435\u0434\u044F \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u044F\u0435\u0442
    \u0435\u0433\u043E \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u044C
    \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435.\n\n\u0421\u0442\u043E\u0438\u0442
    \u043F\u043E\u043D\u0438\u043C\u0430\u0442\u044C, \u0447\u0442\u043E \u043C\u0435\u0434\u0432\u0435\u0434\u044C
    \u0440\u0430\u0431\u043E\u0442\u0430\u044E\u0449\u0438\u0439 \u043D\u0435 \u043F\u043E
    \u0441\u043F\u0435\u0446\u0438\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u0438
    \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u0448\u0442\u0440\u0430\u0444
    \u044D\u0444\u0444\u0435\u043A\u0442\u0438\u0432\u043D\u043E\u0441\u0442\u0438
    - 0.25x.\n\n\u041E\u043F\u044B\u0442 \u043C\u043E\u0436\u043D\u043E \u043F\u043E\u043B\u0443\u0447\u0438\u0442\u044C
    \u043B\u0438\u0431\u043E \u0432 \u0443\u0447\u0435\u0431\u043D\u044B\u0445 \u0443\u0447\u0440\u0435\u0436\u0434\u0435\u043D\u0438\u044F\u0445,
    \u043B\u0438\u0431\u043E \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435.\n\n\u041F\u043E\u0441\u043B\u0435
    400 \u0435\u0434. \u043E\u043F\u044B\u0442\u0430 \u043C\u0435\u0434\u0432\u0435\u0434\u044C
    \u043C\u043E\u0436\u0435\u0442 \u043E\u0431\u0443\u0447\u0430\u0442\u044C\u0441\u044F
    \u0442\u043E\u043B\u044C\u043A\u043E \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435."
