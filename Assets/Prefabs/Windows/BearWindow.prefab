--- !u!114 &2386012778523376855
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3619074404860830911}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 87d38dc7995568443b6ae76432516340, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Info: "\u041C\u0435\u0434\u0432\u0435\u0434\u0438 \u0443\u0441\u0442\u0430\u044E\u0442
    \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u0435 \u0438 \u043E\u0442\u0434\u044B\u0445\u0430\u044E\u0442
    \u0432 \u0436\u0438\u043B\u0438\u0449\u0435. \u041F\u0440\u0438 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u043E\u0439
    \u0443\u0441\u0442\u0430\u043B\u043E\u0441\u0442\u0438 \u0443 \u043C\u0435\u0434\u0432\u0435\u0434\u044F
    \u043D\u0430\u0447\u043D\u0435\u0442 \u0440\u0430\u0441\u0442\u0438 \u0441\u0442\u0440\u0435\u0441\u0441,
    \u0430 \u043F\u0440\u0438 \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0439
    - \u043F\u0435\u0440\u0435\u0441\u0442\u0430\u043D\u0435\u0442 \u0440\u0430\u0431\u043E\u0442\u0430\u0442\u044C.
    \u041E\u0431\u0440\u0430\u0442\u0438\u0442\u0435 \u0432\u043D\u0438\u043C\u0430\u043D\u0438\u0435,
    \u0447\u0442\u043E \u043D\u0430 \u043E\u0434\u043D\u0438\u0445 \u0432\u0438\u0434\u0430\u0445
    \u0440\u0430\u0431\u043E\u0442 \u043C\u0435\u0434\u0432\u0435\u0434\u044C \u0443\u0441\u0442\u0430\u0435\u0442
    \u0431\u044B\u0441\u0442\u0440\u0435\u0435, \u0447\u0435\u043C \u043D\u0430 \u0434\u0440\u0443\u0433\u0438\u0445."
