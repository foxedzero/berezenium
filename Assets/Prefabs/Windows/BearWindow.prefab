  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 87d38dc7995568443b6ae76432516340, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Info: "\u0423\u0434\u043E\u0432\u043B\u0435\u0442\u0432\u043E\u0440\u0451\u043D\u043D\u043E\u0441\u0442\u044C
    \u043C\u0435\u0434\u0432\u0435\u0434\u044F, \u0437\u0430 \u043D\u0435\u0439 \u0441\u0442\u043E\u0438\u0442
    \u0441\u043B\u0435\u0434\u0438\u0442\u044C.\n\n\u0415\u0441\u043B\u0438 \u0432\u0441\u0435
    \u043C\u0435\u0434\u0432\u0435\u0434\u0438 \u0432 \u0433\u043E\u0440\u043E\u0434\u0435
    \u0431\u0443\u0434\u0443\u0442 \u043D\u0435\u0441\u0447\u0430\u0441\u0442\u043D\u044B,
    \u0442\u043E \u043E\u0436\u0438\u0434\u0430\u0439\u0442\u0435 \u0441\u043A\u043E\u0440\u044B\u0439
