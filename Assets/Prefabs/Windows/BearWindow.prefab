--- !u!114 &4508062909368309541
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2177944387871962125}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 87d38dc7995568443b6ae76432516340, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  Info: "\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u043D\u0430\u043F\u0440\u044F\u043C\u0443\u044E
    \u0432\u043B\u0438\u044F\u0435\u0442 \u043D\u0430 \u0440\u0430\u0431\u043E\u0442\u043E\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
    \u043C\u0435\u0434\u0432\u0435\u0434\u044F, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
    \u043D\u0435 \u0441\u0442\u043E\u0438\u0442 \u0434\u043E\u0432\u043E\u0434\u0438\u0442\u044C
    \u0435\u0433\u043E \u0434\u043E \u043A\u0440\u0438\u0442\u0438\u0447\u0435\u0441\u043A\u0438\u0445
    \u0437\u043D\u0430\u0447\u0435\u043D\u0438\u0439.\r\n\u0415\u0441\u043B\u0438
    \u044D\u0442\u043E \u0432\u0441\u0435-\u0442\u0430\u043A\u0438 \u043F\u0440\u043E\u0438\u0437\u043E\u0448\u043B\u043E,
    \u0442\u043E \u043C\u0435\u0434\u0432\u0435\u0434\u044C \u0437\u0430\u0431\u043E\u043B\u0435\u0435\u0442,
    \u0432\u044B\u043B\u0435\u0447\u0438\u0442\u044C \u0435\u0433\u043E \u043C\u043E\u0436\u043D\u043E
    \u0432 \u043C\u0435\u0434\u043F\u0443\u043D\u043A\u0442\u0435, \u043B\u0438\u0431\u043E
    \u0441\u043E\u0437\u0434\u0430\u0432 \u0435\u043C\u0443 \u043A\u043E\u043C\u0444\u043E\u0440\u0442\u043D\u044B\u0435
    \u0443\u0441\u043B\u043E\u0432\u0438\u044F (\u0442\u0435\u043F\u043B\u043E \u0438
    \u0441\u044B\u0442\u043E\u0441\u0442\u044C)"
