--- !u!114 &1949203492
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1949203487}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f64b18f2544ddd849baa88f868cb6d88, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  CG: {fileID: 444687861}
  AudioSource: {fileID: 743331419}
  Text: {fileID: 1951431865}
  Frazes:
  - CG: {fileID: 21300000, guid: 1a13ab8e7a533c74a9d1f478e1054261, type: 3}
    Audio: {fileID: 8300000, guid: 089bdb89daad34848bb3ba28d4f8bfef, type: 3}
    Text: "\u041B\u044E\u0431\u0430\u044F \u0438\u0441\u0442\u043E\u0440\u0438\u044F
      \u0434\u043E\u043B\u0436\u043D\u0430 \u043A\u0430\u043A-\u0442\u043E \u043D\u0430\u0447\u0438\u043D\u0430\u0442\u044C\u0441\u044F,
      \u0438 \u043D\u0430\u0448\u0430 - \u043D\u0435 \u0438\u0441\u043A\u043B\u044E\u0447\u0435\u043D\u0438\u0435.
      \u0415\u0451 \u043D\u0430\u0447\u0430\u043B\u043E \u0431\u044B\u043B\u043E
      \u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043E \u043E\u0441\u0435\u043D\u044C\u044E
      2142 \u0433\u043E\u0434\u0430, \u0441 \u043E\u0447\u0435\u0440\u0435\u0434\u043D\u043E\u0433\u043E
      \u043C\u0430\u0441\u0448\u0442\u0430\u0431\u043D\u043E\u0433\u043E \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u044F
      - \u043E\u0434\u043D\u043E\u0433\u043E \u0438\u0437 \u0442\u0435\u0445, \u0433\u0434\u0435
      \u043E\u0431\u044B\u0447\u043D\u043E \u043E\u0431\u0441\u0443\u0436\u0434\u0430\u044E\u0442
      \u043F\u0440\u043E\u0431\u043B\u0435\u043C\u044B \u0440\u0430\u0441\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u0438\u044F
      \u0440\u0435\u0441\u0443\u0440\u0441\u043E\u0432. \u041C\u043D\u0435\u043D\u0438\u044F
      \u043D\u0430 \u044D\u0442\u043E\u0442 \u0441\u0447\u0435\u0442 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u043E\u0442\u043B\u0438\u0447\u0430\u043B\u0438\u0441\u044C
      \u0434\u0440\u0443\u0433 \u043E\u0442 \u0434\u0440\u0443\u0433\u0430, \u0447\u0442\u043E
      \u043E\u0431\u0441\u0443\u0436\u0434\u0435\u043D\u0438\u0435 \u043D\u0435\u0440\u0435\u0434\u043A\u043E
      \u043F\u0435\u0440\u0435\u0440\u0430\u0441\u0442\u0430\u043B\u043E \u0432 \u043E\u0436\u0438\u0432\u043B\u0435\u043D\u043D\u044B\u0435
      \u0434\u0435\u0431\u0430\u0442\u044B."
    Change: 1
  - CG: {fileID: 21300000, guid: 1a13ab8e7a533c74a9d1f478e1054261, type: 3}
    Audio: {fileID: 8300000, guid: 089bdb89daad34848bb3ba28d4f8bfef, type: 3}
    Text: "\"\u0422\u0430\u043A \u0437\u0430\u0447\u0435\u043C \u0436\u0435 \u044F
      \u0441\u044E\u0434\u0430 \u043F\u0440\u0438\u0448\u0435\u043B? \u042F \u0432\u0435\u0434\u044C
      \u0434\u0430\u0436\u0435 \u043D\u0435 \u0434\u0435\u0431\u0430\u0442\u0435\u0440\"
      - \u043F\u0440\u043E\u043D\u0435\u0441\u043B\u043E\u0441\u044C \u0432 \u043C\u043E\u0435\u0439
      \u0433\u043E\u043B\u043E\u0432\u0435. \u0412\u043F\u0440\u043E\u0447\u0435\u043C,
      \u044F \u0437\u043D\u0430\u043B \u043E\u0442\u0432\u0435\u0442 \u043D\u0430
      \u044D\u0442\u043E\u0442 \u0432\u043E\u043F\u0440\u043E\u0441: \u0441\u0435\u0433\u043E\u0434\u043D\u044F\u0448\u043D\u0435\u0435
      \u0441\u043E\u0431\u0440\u0430\u043D\u0438\u0435 \u043E\u0431\u0435\u0449\u0430\u043B\u043E
      \u043E\u0442\u043B\u0438\u0447\u0430\u0442\u044C\u0441\u044F \u043E\u0442 \u043F\u0440\u0435\u0434\u044B\u0434\u0443\u0449\u0438\u0445.
      \u0412 \u043F\u043E\u0432\u0435\u0441\u0442\u043A\u0435 \u0434\u043D\u044F
      \u0437\u043D\u0430\u0447\u0438\u043B\u0438\u0441\u044C \u0442\u0430\u043A\u0438\u0435
      \u0442\u0435\u043C\u044B, \u043A\u0430\u043A \u044D\u0432\u043E\u043B\u044E\u0446\u0438\u044F
      \u043A\u0438\u0431\u0435\u0440\u043F\u0447\u0435\u043B, \u043D\u0435\u0443\u0442\u0435\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
      \u0440\u043E\u0441\u0442 \u0441\u043B\u0443\u0447\u0430\u0435\u0432 \u0437\u0430\u0436\u0438\u0440\u043E\u0432\u043A\u0438
      \u0438, \u043D\u0430\u043A\u043E\u043D\u0435\u0446, \u043D\u0435\u0434\u0430\u0432\u043D\u044F\u044F
      \u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0430\u0446\u0438\u044F \u043A\u0440\u043E\u0442\u043E\u0432\u043E\u0439
      \u043D\u043E\u0440\u044B, \u0432\u0435\u0434\u0443\u0449\u0435\u0439 \u043D\u0430
      \u043D\u0435\u0438\u0437\u0443\u0447\u0435\u043D\u043D\u0443\u044E \u043F\u043B\u0430\u043D\u0435\u0442\u0443."
    Change: 0
  - CG: {fileID: 21300000, guid: 0f0cc56e7fbeaef459c7d6f60fd11ad3, type: 3}
    Audio: {fileID: 8300000, guid: 089bdb89daad34848bb3ba28d4f8bfef, type: 3}
    Text: "\u0421 \u044D\u0442\u0438\u043C\u0438 \u043C\u044B\u0441\u043B\u044F\u043C\u0438
      \u044F \u0432\u043E\u0448\u0435\u043B \u0432 \u0437\u0430\u043B, \u043E\u0433\u043B\u044F\u0434\u0435\u043B
      \u0435\u0433\u043E \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u043D\u044B\u0435
      \u0441\u0432\u043E\u0434\u044B, \u0437\u0430\u0442\u0435\u043C \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F
      \u043F\u043E \u0441\u0442\u0443\u043F\u0435\u043D\u044F\u043C \u0438 \u0441\u0435\u043B,
      \u0437\u0430\u0442\u0430\u0438\u0432\u0448\u0438\u0441\u044C \u0432 \u043E\u0436\u0438\u0434\u0430\u043D\u0438\u0438."
    Change: 1
  - CG: {fileID: 21300000, guid: 0f0cc56e7fbeaef459c7d6f60fd11ad3, type: 3}
    Audio: {fileID: 8300000, guid: 089bdb89daad34848bb3ba28d4f8bfef, type: 3}
    Text: "\u0412\u0441\u0435, \u0447\u0442\u043E \u0431\u044B\u043B\u043E \u0434\u0430\u043B\u044C\u0448\u0435,
      \u044F \u043F\u043E\u043C\u043D\u044E \u043A\u0430\u043A \u0432 \u0442\u0443\u043C\u0430\u043D\u0435.
      \u041C\u0438\u043C\u043E \u043C\u0435\u043D\u044F \u0442\u043E \u0438 \u0434\u0435\u043B\u043E
      \u043F\u0440\u043E\u043D\u043E\u0441\u0438\u043B\u0438\u0441\u044C \u043E\u0431\u0440\u044B\u0432\u043A\u0438
      \u0444\u0440\u0430\u0437 \u0432\u044B\u0441\u043E\u043A\u043E\u043F\u043E\u0441\u0442\u0430\u0432\u043B\u0435\u043D\u043D\u044B\u0445
      \u043C\u0435\u0434\u0432\u0435\u0434\u0435\u0439, \u0432\u044B\u0441\u0442\u0443\u043F\u0430\u0432\u0448\u0438\u0445
      \u0441 \u0434\u043E\u043A\u043B\u0430\u0434\u0430\u043C\u0438, \u043A\u043E\u0442\u043E\u0440\u044B\u0435
      \u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C \u043C\u043D\u0435 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0440\u0443\u0442\u0438\u043D\u043D\u044B\u043C\u0438, \u0447\u0442\u043E
      \u043F\u043E\u0441\u0442\u0435\u043F\u0435\u043D\u043D\u043E \u044F \u043D\u0430\u0447\u0430\u043B
      \u0437\u0430\u0441\u044B\u043F\u0430\u0442\u044C. \"\u041C\u044B \u043E\u0442\u043A\u0440\u044B\u043B\u0438
      \u043D\u043E\u0432\u0443\u044E \u043F\u043B\u0430\u043D\u0435\u0442\u0443!\"
      - \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E \u0440\u0430\u0437\u043D\u0435\u0441\u043B\u043E\u0441\u044C
      \u044D\u0445\u043E\u043C \u043D\u0430 \u0432\u0435\u0441\u044C \u0437\u0430\u043B,
      \u043C\u043E\u043C\u0435\u043D\u0442\u0430\u043B\u044C\u043D\u043E \u043F\u0440\u0438\u0432\u0435\u0434\u044F
      \u043C\u0435\u043D\u044F \u0432 \u0447\u0443\u0432\u0441\u0442\u0432\u043E."
    Change: 0
  - CG: {fileID: 21300000, guid: 0f0cc56e7fbeaef459c7d6f60fd11ad3, type: 3}
    Audio: {fileID: 8300000, guid: 089bdb89daad34848bb3ba28d4f8bfef, type: 3}
    Text: "\u041A\u0430\u043A \u043E\u043A\u0430\u0437\u0430\u043B\u043E\u0441\u044C,
      \u043D\u0435\u043F\u043E\u0434\u0430\u043B\u0435\u043A\u0443 \u043E\u0442 \u043E\u0440\u0431\u0438\u0442\u044B
      \u043D\u0430\u0448\u0435\u0439 \u0440\u043E\u0434\u043D\u043E\u0439 \u0411\u0435\u0440\u043B\u043E\u0433\u0438
      \u0431\u044B\u043B\u0430 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0430
      \u043D\u0435\u0434\u0430\u0432\u043D\u043E \u0441\u0442\u0430\u0431\u0438\u043B\u0438\u0437\u0438\u0440\u043E\u0432\u0430\u0432\u0448\u0430\u044F\u0441\u044F
      \u043A\u0440\u043E\u0442\u043E\u0432\u0430\u044F \u043D\u043E\u0440\u0430.
      \u0418\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u0432 \u043F\u0440\u0438
      \u043F\u043E\u043C\u043E\u0449\u0438 \u0437\u043E\u043D\u0434\u043E\u0432 \u0435\u0435
      \u043E\u0431\u0440\u0430\u0442\u043D\u0443\u044E \u0441\u0442\u043E\u0440\u043E\u043D\u0443,
      \u0443\u0447\u0435\u043D\u044B\u0435 \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438
      \u043B\u0435\u0434\u044F\u043D\u0443\u044E \u043F\u043B\u0430\u043D\u0435\u0442\u0443.
      \u0418\u0437-\u0437\u0430 \u043E\u0431\u0438\u043B\u0438\u044F \u0434\u0440\u0435\u0432\u0435\u0441\u043D\u044B\u0445
      \u0440\u0430\u0441\u0442\u0435\u043D\u0438\u0439, \u043D\u0430\u043F\u043E\u043C\u0438\u043D\u0430\u044E\u0449\u0438\u0445
      \u0431\u0435\u0440\u0435\u0437\u0443, \u0431\u044B\u043B\u043E \u0440\u0435\u0448\u0435\u043D\u043E
      \u043D\u0430\u0437\u0432\u0430\u0442\u044C \u0435\u0435 \u0411\u0435\u0440\u0435\u0437\u0438\u0435\u0439."
    Change: 0
  - CG: {fileID: 21300000, guid: 0f0cc56e7fbeaef459c7d6f60fd11ad3, type: 3}
    Audio: {fileID: 8300000, guid: 089bdb89daad34848bb3ba28d4f8bfef, type: 3}
    Text: "\u041E\u0434\u043D\u0430\u043A\u043E, \u043E\u0434\u043D\u0438\u0445 \u0437\u043E\u043D\u0434\u043E\u0432
      \u0434\u043B\u044F \u0438\u0441\u0441\u043B\u0435\u0434\u043E\u0432\u0430\u043D\u0438\u044F
      \u0431\u044B\u043B\u043E \u044F\u0432\u043D\u043E \u043D\u0435\u0434\u043E\u0441\u0442\u0430\u0442\u043E\u0447\u043D\u043E.
      \u0420\u0430\u0441\u0441\u0447\u0435\u0442\u044B \u043C\u0430\u0433\u043D\u0438\u0442\u043D\u043E\u0433\u043E
      \u0444\u043E\u043D\u0430 \u043F\u043B\u0430\u043D\u0435\u0442\u044B \u0432\u0441\u0435
      \u0432\u0440\u0435\u043C\u044F \u0434\u0430\u0432\u0430\u043B\u0438 \u0440\u0430\u0437\u043D\u044B\u0435
      \u0440\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B, \u0447\u0442\u043E
      \u0443\u043A\u0430\u0437\u044B\u0432\u0430\u043B\u043E \u043D\u0430 \u043D\u0430\u043B\u0438\u0447\u0438\u0435
      \u0443 \u0411\u0435\u0440\u0435\u0437\u0438\u0438 \u0441\u043E\u0432\u0435\u0440\u0448\u0435\u043D\u043D\u043E
      \u0443\u043D\u0438\u043A\u0430\u043B\u044C\u043D\u044B\u0445 \u0438 \u043D\u0435\u0442\u0438\u043F\u0438\u0447\u043D\u044B\u0445
      \u0441\u0432\u043E\u0439\u0441\u0442\u0432. \u0421\u0442\u0440\u0435\u043C\u044F\u0441\u044C
      \u0440\u0430\u0437\u043E\u0431\u0440\u0430\u0442\u044C\u0441\u044F, \u0443\u0447\u0435\u043D\u044B\u0435
      \u0440\u0435\u0448\u0438\u043B\u0438 \u0441\u043D\u0430\u0440\u044F\u0434\u0438\u0442\u044C
      \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0443\u044E \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u044E.
      \u042F \u0431\u044B\u043B \u043E\u0434\u043D\u0438\u043C \u0438\u0437 \u043F\u0435\u0440\u0432\u044B\u0445,
      \u043A\u0442\u043E \u043F\u0440\u0435\u0434\u043B\u043E\u0436\u0438\u043B \u0441\u0432\u043E\u044E
      \u043A\u0430\u043D\u0434\u0438\u0434\u0430\u0442\u0443\u0440\u0443."
    Change: 0
  - CG: {fileID: 21300000, guid: 5a1654e06debe62439182d9854536379, type: 3}
    Audio: {fileID: 8300000, guid: 089bdb89daad34848bb3ba28d4f8bfef, type: 3}
    Text: "\"\u0418\u043D\u0438\u0446\u0438\u0430\u0442\u0438\u0432\u0430 \u043D\u0430\u043A\u0430\u0437\u0443\u0435\u043C\u0430\"
      - \u043F\u043E\u0434\u0443\u043C\u0430\u043B \u044F, \u043E\u043A\u0430\u0437\u0430\u0432\u0448\u0438\u0441\u044C
      \u0447\u0435\u0440\u0435\u0437 \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E
      \u0434\u043D\u0435\u0439 \u0432 \u043A\u043E\u0441\u043C\u043E\u043F\u043E\u0440\u0442\u0435.
      \u041C\u0435\u043D\u044F \u043D\u0430\u0437\u043D\u0430\u0447\u0438\u043B\u0438
      \u043A\u0430\u043F\u0438\u0442\u0430\u043D\u043E\u043C, \u043D\u043E \u044F
      \u0431\u044B\u043B \u0441\u043E\u0432\u0441\u0435\u043C \u043D\u0435 \u043F\u0440\u043E\u0442\u0438\u0432,
      \u0432\u0435\u0434\u044C \u044F \u0431\u044B\u043B \u0442\u0432\u043E\u0440\u0446\u043E\u043C
      \u0438, \u0431\u043E\u043B\u0435\u0435 \u0442\u043E\u0433\u043E, \u0441\u043B\u044B\u043B
      \u043F\u0440\u0438\u0440\u043E\u0436\u0434\u0435\u043D\u043D\u044B\u043C \u043B\u0438\u0434\u0435\u0440\u043E\u043C.
      \u041A\u0440\u043E\u043C\u0435 \u0442\u043E\u0433\u043E, \u043A\u043E\u043C\u0443,
      \u043A\u0430\u043A \u043D\u0435 \u043C\u043D\u0435, \u043C\u043E\u0436\u043D\u043E
      \u0434\u043E\u0432\u0435\u0440\u0438\u0442\u044C \u0441\u0443\u0434\u044C\u0431\u044B
      \u0447\u043B\u0435\u043D\u043E\u0432 \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u0438?"
    Change: 1
  - CG: {fileID: 21300000, guid: 5a1654e06debe62439182d9854536379, type: 3}
    Audio: {fileID: 8300000, guid: 089bdb89daad34848bb3ba28d4f8bfef, type: 3}
    Text: "\u042F \u043E\u0433\u043B\u044F\u0434\u0435\u043B \u0440\u043E\u0434\u043D\u0443\u044E
      \u043F\u043B\u0430\u043D\u0435\u0442\u0443, \u043F\u043E\u0439\u043C\u0430\u0432
      \u0441\u0435\u0431\u044F \u043D\u0430 \u043C\u044B\u0441\u043B\u0438 \u043E
      \u0442\u043E\u043C, \u0447\u0442\u043E \u043D\u0435 \u0441\u043A\u043E\u0440\u043E
      \u0443\u0432\u0438\u0436\u0443 \u0435\u0435 \u0436\u0438\u0432\u043E\u043F\u0438\u0441\u043D\u044B\u0435
      \u043F\u0435\u0439\u0437\u0430\u0436\u0438, \u0437\u0430\u0442\u0435\u043C
      \u043F\u043E\u0434\u043D\u044F\u043B\u0441\u044F \u043F\u043E \u043D\u0430\u0434\u0435\u0436\u043D\u043E
      \u0437\u0430\u0444\u0438\u043A\u0441\u0438\u0440\u043E\u0432\u0430\u043D\u043D\u043E\u043C\u0443
      \u0442\u0440\u0430\u043F\u0443 \u043D\u0430 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0439
      \u043A\u043E\u0440\u0430\u0431\u043B\u044C. \u041E\u043A\u0430\u0437\u0430\u0432\u0448\u0438\u0441\u044C
      \u0432\u043D\u0443\u0442\u0440\u0438 \u0432\u043E\u0437\u0434\u0443\u0448\u043D\u043E\u0433\u043E
      \u0441\u0443\u0434\u043D\u0430 \u044F \u0441\u0440\u0430\u0437\u0443 \u0436\u0435
      \u043F\u0440\u043E\u0448\u0435\u043B \u043A \u043A\u0430\u043F\u0438\u0442\u0430\u043D\u0441\u043A\u043E\u043C\u0443
      \u043C\u043E\u0441\u0442\u0438\u043A\u0443 \u0438 \u0437\u0430\u043D\u044F\u043B
      \u043F\u043E\u043B\u0430\u0433\u0430\u044E\u0449\u0435\u0435\u0441\u044F \u043C\u043D\u0435
      \u043A\u0440\u0435\u0441\u043B\u043E \u043A\u043E\u043C\u0430\u043D\u0434\u0438\u0440\u0430
      \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u0438."
    Change: 0
  - CG: {fileID: 21300000, guid: 029bfb0b3bcbe0b4a807e7ad902f14a8, type: 3}
    Audio: {fileID: 8300000, guid: 089bdb89daad34848bb3ba28d4f8bfef, type: 3}
    Text: "\u0421\u043A\u043E\u0440\u043E \u043C\u044B \u0443\u043B\u0430\u0434\u0438\u043B\u0438
      \u0432\u0441\u0435 \u043E\u0440\u0433\u0430\u043D\u0438\u0437\u0430\u0446\u0438\u043E\u043D\u043D\u044B\u0435
      \u043C\u043E\u043C\u0435\u043D\u0442\u044B, \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043B\u0438\u0441\u044C
      \u043F\u043E\u0441\u043B\u0435\u0434\u043D\u0438\u0435 \u043F\u0440\u0438\u0433\u043E\u0442\u043E\u0432\u043B\u0435\u043D\u0438\u044F,
      \u0438 \u043D\u0430\u0448 \u043A\u043E\u0440\u0430\u0431\u043B\u044C \u0441\u0442\u0430\u0440\u0442\u043E\u0432\u0430\u043B.
      \u0418 \u0432\u043E\u0442 \u043C\u044B \u0443\u0436\u0435 \u0431\u043E\u0440\u043E\u0437\u0434\u0438\u043B\u0438
      \u0431\u0435\u0441\u043A\u0440\u0430\u0439\u043D\u0438\u0435 \u043A\u043E\u0441\u043C\u0438\u0447\u0435\u0441\u043A\u0438\u0435
      \u043F\u0440\u043E\u0441\u0442\u043E\u0440\u044B, \u043F\u0440\u0438\u0431\u043B\u0438\u0436\u0430\u044F\u0441\u044C
      \u043A \u043A\u0440\u043E\u0442\u043E\u0432\u043E\u0439 \u043D\u043E\u0440\u0435,
      \u0440\u0430\u0441\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u043D\u043E\u0439
      \u0441\u0440\u0430\u0432\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u043E \u0431\u043B\u0438\u0437\u043A\u043E."
    Change: 1
  - CG: {fileID: 21300000, guid: 029bfb0b3bcbe0b4a807e7ad902f14a8, type: 3}
    Audio: {fileID: 8300000, guid: 089bdb89daad34848bb3ba28d4f8bfef, type: 3}
    Text: "\u041F\u0440\u043E\u0448\u043B\u043E \u0435\u0449\u0435 \u043D\u0435\u043C\u043D\u043E\u0433\u043E
      \u0432\u0440\u0435\u043C\u0435\u043D\u0438, \u0438 \u043C\u044B \u0443\u0436\u0435
      \u043F\u043E\u0434\u043B\u0435\u0442\u0430\u043B\u0438 \u043A \u043D\u043E\u0440\u0435,
      \u0438\u0441\u043F\u044B\u0442\u044B\u0432\u0430\u044F \u043D\u0435\u0443\u0434\u0435\u0440\u0436\u0438\u043C\u043E\u0435
      \u0432\u043E\u043B\u043D\u0435\u043D\u0438\u0435. \u0412\u043F\u0440\u043E\u0447\u0435\u043C,
      \u043C\u044B \u0431\u044B\u043B\u0438 \u0443\u0432\u0435\u0440\u0435\u043D\u044B
      \u0432 \u0440\u0430\u0441\u0441\u0447\u0435\u0442\u0430\u0445 \u0441\u0432\u0435\u0442\u043B\u044B\u0445
      \u0443\u043C\u043E\u0432 \u0411\u0435\u0440\u043B\u043E\u0433\u0438, \u043F\u043E\u044D\u0442\u043E\u043C\u0443
      \u0432\u043B\u0435\u0442\u0435\u043B\u0438 \u0432 \u043D\u0435\u0435 \u0441\u043E
      \u0441\u043F\u043E\u043A\u043E\u0439\u043D\u043E\u0439 \u0434\u0443\u0448\u043E\u0439."
    Change: 0
  - CG: {fileID: 21300000, guid: e2904bc91563d2a4091dabf31692396a, type: 3}
    Audio: {fileID: 8300000, guid: bce2de8311e1ba443a879951cd4c91bc, type: 3}
    Text: "\u0422\u0430\u043A \u043C\u044B \u043E\u043A\u0430\u0437\u0430\u043B\u0438\u0441\u044C
      \u0432 \u0434\u0440\u0443\u0433\u043E\u0439 \u0447\u0430\u0441\u0442\u0438
      \u0433\u0430\u043B\u0430\u043A\u0442\u0438\u043A\u0438, \u0438 \u043D\u0430\u0448\u0435\u043C\u0443
      \u0432\u0437\u043E\u0440\u0443 \u043F\u0440\u0435\u0434\u0441\u0442\u0430\u043B\u0430
      \u043E\u0441\u043B\u0435\u043F\u0438\u0442\u0435\u043B\u044C\u043D\u043E-\u043B\u0435\u0434\u044F\u043D\u0430\u044F
      \u0411\u0435\u0440\u0435\u0437\u0438\u044F. \u0420\u0430\u0441\u0441\u043B\u0430\u0431\u0438\u0432\u0448\u0438\u0441\u044C,
      \u0443\u0436\u0435 \u043D\u0430\u0447\u0430\u043B\u0438 \u043F\u0440\u0435\u0434\u0432\u0435\u0449\u0430\u0442\u044C
      \u0443\u0441\u043F\u0435\u0445 \u043D\u0430\u0448\u0435\u0439 \u044D\u043A\u0441\u043F\u0435\u0434\u0438\u0446\u0438\u0438,
      \u043A\u0430\u043A \u0432\u0434\u0440\u0443\u0433 \u0440\u0430\u0437\u0434\u0430\u043B\u0438\u0441\u044C
      \u0437\u0432\u0443\u043A\u0438 \u0441\u0438\u0440\u0435\u043D\u044B. \"\u041E\u0431\u043D\u0430\u0440\u0443\u0436\u0435\u043D\u0430
      \u0433\u0440\u0430\u0432\u0438\u0442\u0430\u0446\u0438\u043E\u043D\u043D\u043E-\u043C\u0430\u0433\u043D\u0438\u0442\u043D\u0430\u044F
      \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u044F\" - \u0440\u0430\u0437\u043D\u0435\u0441\u043B\u043E\u0441\u044C
      \u043F\u043E \u0432\u0441\u0435\u043C\u0443 \u043A\u043E\u0440\u0430\u0431\u043B\u044E.
      \u041E\u043F\u0440\u0430\u0432\u0438\u0432\u0448\u0438\u0441\u044C \u043F\u043E\u0441\u043B\u0435
      \u0442\u0430\u043A\u043E\u0439 \u043D\u0435\u043E\u0436\u0438\u0434\u0430\u043D\u043D\u043E\u0441\u0442\u0438,
      \u043C\u044B \u0441 \u0443\u0436\u0430\u0441\u043E\u043C \u043E\u0431\u043D\u0430\u0440\u0443\u0436\u0438\u043B\u0438,
      \u0447\u0442\u043E \u0432\u0441\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u0438
      \u043A\u043E\u0441\u043C\u043E\u043B\u0435\u0442\u0430 \u043E\u0442\u043A\u0430\u0437\u0430\u043B\u0438,
      \u0430 \u0441\u0430\u043C \u043E\u043D \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u043B
      \u0441 \u043D\u0435\u0432\u043E\u043E\u0431\u0440\u0430\u0437\u0438\u043C\u043E\u0439
      \u0441\u043A\u043E\u0440\u043E\u0441\u0442\u044C\u044E \u043D\u0435\u0441\u0442\u0438
      \u043D\u0430\u0441 \u043F\u0440\u044F\u043C\u043E \u043A \u043F\u043B\u0430\u043D\u0435\u0442\u0435."
    Change: 1
  - CG: {fileID: 21300000, guid: e2904bc91563d2a4091dabf31692396a, type: 3}
    Audio: {fileID: 8300000, guid: bce2de8311e1ba443a879951cd4c91bc, type: 3}
    Text: "\"\u042F \u0434\u043E\u043B\u0436\u0435\u043D \u0447\u0442\u043E-\u0442\u043E
      \u0441\u0434\u0435\u043B\u0430\u0442\u044C, \u043E\u0442 \u043C\u0435\u043D\u044F
      \u0437\u0430\u0432\u0438\u0441\u044F\u0442 \u0436\u0438\u0437\u043D\u0438 \u043A\u043E\u043C\u0430\u043D\u0434\u044B!\"
      - \u043C\u0435\u043B\u044C\u043A\u043D\u0443\u043B\u043E \u0443 \u043C\u0435\u043D\u044F
      \u0432 \u0433\u043E\u043B\u043E\u0432\u0435, \u044F \u0438 \u043E\u0442\u0434\u0430\u043B
      \u043F\u0440\u0438\u043A\u0430\u0437 \u043E\u0431 \u044D\u043A\u0441\u0442\u0440\u0435\u043D\u043D\u043E\u0439
      \u043F\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u043A\u0435 \u0434\u0432\u0438\u0433\u0430\u0442\u0435\u043B\u0435\u0439.
      \u041A \u0441\u043E\u0436\u0430\u043B\u0435\u043D\u0438\u044E, \u0430\u043D\u043E\u043C\u0430\u043B\u0438\u044F
      \u0431\u044B\u043B\u0430 \u043D\u0430\u0441\u0442\u043E\u043B\u044C\u043A\u043E
      \u0441\u0438\u043B\u044C\u043D\u043E\u0439, \u0447\u0442\u043E \u044D\u0442\u0430
      \u0437\u0430\u0442\u0435\u044F \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
      \u043F\u0440\u043E\u0432\u0430\u043B\u0438\u043B\u0430\u0441\u044C. \u0423
      \u043C\u0435\u043D\u044F \u043D\u0435 \u043E\u0441\u0442\u0430\u0432\u0430\u043B\u043E\u0441\u044C
      \u0434\u0440\u0443\u0433\u043E\u0433\u043E \u0432\u044B\u0445\u043E\u0434\u0430
      - \u044F \u0431\u044B\u043B \u0432\u044B\u043D\u0443\u0436\u0434\u0435\u043D
      \u043E\u0431\u044A\u044F\u0432\u0438\u0442\u044C \u044D\u0432\u0430\u043A\u0443\u0430\u0446\u0438\u044E.
      \u0420\u0430\u0437\u043C\u0435\u0441\u0442\u0438\u0432 \u0447\u043B\u0435\u043D\u043E\u0432
      \u043A\u043E\u043C\u0430\u043D\u0434\u044B \u0432 \u0441\u043F\u0430\u0441\u0430\u0442\u0435\u043B\u044C\u043D\u044B\u0445
      \u043A\u0430\u043F\u0441\u0443\u043B\u0430\u0445, \u044F \u0442\u043E\u0436\u0435
      \u0437\u0430\u043D\u044F\u043B \u043C\u0435\u0441\u0442\u043E \u0432 \u043E\u0434\u043D\u043E\u0439
      \u0438\u0437 \u043D\u0438\u0445."
    Change: 0
  - CG: {fileID: 21300000, guid: 96ae88e579c914a4299c62c95f0cdd61, type: 3}
    Audio: {fileID: 8300000, guid: bce2de8311e1ba443a879951cd4c91bc, type: 3}
    Text: "\u041D\u0430 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E\u0439
      \u0432\u044B\u0441\u043E\u0442\u0435 \u043A\u0430\u043F\u0441\u0443\u043B\u044B
      \u043E\u0442\u0441\u043E\u0435\u0434\u0438\u043D\u0438\u043B\u0438\u0441\u044C
      \u043E\u0442 \u043A\u043E\u0440\u0430\u0431\u043B\u044F \u0438 \u043D\u0430\u0447\u0430\u043B\u0438
      \u043F\u0438\u043A\u0438\u0440\u043E\u0432\u0430\u0442\u044C \u043A \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u0438
      \u043F\u043B\u0430\u043D\u0435\u0442\u044B. \u0421\u043F\u0443\u0441\u0442\u044F
      \u043D\u0435\u0441\u043A\u043E\u043B\u044C\u043A\u043E \u0441\u0435\u043A\u0443\u043D\u0434
      \u043A\u043E\u0441\u043C\u043E\u043B\u0435\u0442 \u0432\u0437\u043E\u0440\u0432\u0430\u043B\u0441\u044F,
      \u043E\u0431\u0440\u0443\u0448\u0438\u0432 \u043D\u0430 \u043D\u0430\u0441
      \u043E\u0433\u043B\u0443\u0448\u0438\u0442\u0435\u043B\u044C\u043D\u0443\u044E
      \u0432\u0437\u0440\u044B\u0432\u043D\u0443\u044E \u0432\u043E\u043B\u043D\u0443."
    Change: 1
  - CG: {fileID: 21300000, guid: 96ae88e579c914a4299c62c95f0cdd61, type: 3}
    Audio: {fileID: 8300000, guid: bce2de8311e1ba443a879951cd4c91bc, type: 3}
    Text: "\u0421\u0443\u0434\u044F \u043F\u043E \u0432\u0441\u0435\u043C\u0443,
      \u043A\u0430\u043F\u0441\u0443\u043B\u044B \u0443\u043F\u0430\u043B\u0438 \u043D\u0435\u0434\u0430\u043B\u0435\u043A\u043E
      \u0434\u0440\u0443\u0433 \u043E\u0442 \u0434\u0440\u0443\u0433\u0430, \u0447\u0442\u043E
      \u043F\u043E\u0437\u0432\u043E\u043B\u0438\u0442 \u043C\u043D\u0435 \u0432
      \u043A\u0440\u0430\u0442\u0447\u0430\u0439\u0448\u0438\u0435 \u0441\u0440\u043E\u043A\u0438
      \u0440\u0435\u043E\u0440\u0433\u0430\u043D\u0438\u0437\u043E\u0432\u0430\u0442\u044C
      \u043A\u043E\u043C\u0430\u043D\u0434\u0443. \u0421\u0438\u0442\u0443\u0430\u0446\u0438\u044F,
      \u0432 \u043A\u043E\u0442\u043E\u0440\u0443\u044E \u043C\u044B \u043F\u043E\u043F\u0430\u043B\u0438,
      \u043D\u0435 \u0438\u0437 \u043F\u0440\u043E\u0441\u0442\u044B\u0445, \u043D\u043E
      \u043E\u0442\u0447\u0430\u0438\u0432\u0430\u0442\u044C\u0441\u044F - \u0442\u043E\u0447\u043D\u043E
      \u043D\u0435 \u0432\u044B\u0445\u043E\u0434. \u041A\u0430\u043A \u043A\u0430\u043F\u0438\u0442\u0430\u043D,
      \u044F \u043E\u0431\u044F\u0437\u0430\u043D \u043F\u043E\u0437\u0430\u0431\u043E\u0442\u0438\u0442\u044C\u0441\u044F
      \u043E \u043A\u0430\u0436\u0434\u043E\u043C \u0447\u043B\u0435\u043D\u0435
      \u044D\u043A\u0438\u043F\u0430\u0436\u0430 \u0438 \u043E\u0431\u0435\u0441\u043F\u0435\u0447\u0438\u0442\u044C
      \u0432\u0441\u0435\u043C \u0434\u043E\u0441\u0442\u043E\u0439\u043D\u044B\u0435
      \u0438 \u0440\u0430\u0432\u043D\u044B\u0435 \u0443\u0441\u043B\u043E\u0432\u0438\u044F."
    Change: 0
  - CG: {fileID: 21300000, guid: 96ae88e579c914a4299c62c95f0cdd61, type: 3}
    Audio: {fileID: 8300000, guid: bce2de8311e1ba443a879951cd4c91bc, type: 3}
    Text: "\u041E\u0447\u043D\u0443\u0432\u0448\u0438\u0441\u044C \u043F\u043E\u0441\u043B\u0435
      \u043F\u0440\u0438\u0437\u0435\u043C\u043B\u0435\u043D\u0438\u044F, \u044F
      \u0432\u0441\u0442\u0430\u043B, \u043E\u0449\u0443\u0442\u0438\u0432 \u0432\u0441\u0435\u043C
      \u0442\u0435\u043B\u043E\u043C \u0445\u043E\u043B\u043E\u0434 \u0438 \u043D\u0435\u043F\u0440\u0438\u0432\u0435\u0442\u043B\u0438\u0432\u043E\u0441\u0442\u044C
      \u044D\u0442\u043E\u0439 \u0441\u0443\u0440\u043E\u0432\u043E\u0439 \u043F\u043B\u0430\u043D\u0435\u0442\u044B.
      \"\u041C\u0435\u043D\u044F \u0436\u0434\u0443\u0442 \u0432\u0435\u043B\u0438\u043A\u0438\u0435
      \u0434\u0435\u043B\u0430\" - \u0440\u0435\u0448\u0438\u043B \u044F \u0438 \u043E\u0442\u043F\u0440\u0430\u0432\u0438\u043B\u0441\u044F
      \u043D\u0430 \u043F\u043E\u0438\u0441\u043A\u0438 \u044D\u043A\u0438\u043F\u0430\u0436\u0430."
    Change: 0
  CurrentFraze: -1
